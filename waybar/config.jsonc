[
	{
		"output": ["DP-1", "eDP-1"],
		"layer": "bottom",
		"position": "top",
		"height": 60,
		"spacing": 25,

		"modules-left": ["hyprland/workspaces"],
		"modules-right": ["network", "cpu", "memory", "pulseaudio", "clock", "custom/notifications"],
		"hyprland/workspaces": {
			"format": "{name}",
			"disable-scroll": true
		},
		"network": {
			"format-wifi": "WIFI: {essid} ({signalStrength}%)",
			"format-ethernet": "ETH: {ifname}",
			"tooltip-format": " {ifname} via {gwaddr}",
			"format-linked": " {ifname} (No IP)",
			"format-disconnected": "Disconnected ⚠ {ifname}",
			"format-alt": " {ifname}: {ipaddr}/{cidr}"
		},
		"cpu": {
			"format": "CPU: {usage}%",
			"interval": 2,
            "tooltip": true
		},
		"memory": {
			"interval": 30,
			"format": "RAM: {used:0.1f}G/{total:0.1f}G"
		},
		"pulseaudio": {
			"scroll-step": 5,
			"max-volume": 150,
			"format": "{volume}%",
			"on-click": "pavucontrol"
		},
		"clock": {
			"format": "{:%a %d-%m-%Y}",
            "tooltip": false
        },
        "custom/notifications": {
            "tooltip": true,
            "format": "<span size='20pt'>{icon} </span>",
            "format-icons": {
                "notification": "󱅫",
                "none": "󰂜",
                "dnd-notification": "󰂠",
                "dnd-none": "󰪓",
                "inhibited-notification": "󰂛",
                "inhibited-none": "󰪑",
                "dnd-inhibited-notification": "󰂛",
                "dnd-inhibited-none": "󰪑"
            },
            "return-type": "json",
            "exec-if": "which swaync-client",
            "exec": "swaync-client -swb",
            "on-click": "swaync-client -t -sw",
            "on-click-right": "swaync-client -d -sw",
            "escape": true
        }
	}
]
