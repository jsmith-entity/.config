[
	{
		"output": ["DP-1", "eDP-1"],
		"layer": "bottom",
		"position": "top",
		"height": 60,
		"spacing": 25,

		"modules-left": ["hyprland/workspaces"],
		"modules-right": ["network", "cpu", "memory", "pulseaudio", "clock"],
		"hyprland/workspaces": {
			"format": "{name}",
			"disable-scroll": true
		},
		"network": {
			"format-wifi": "{essid} ({signalStrength}%) ",
			"format-ethernet": " {ifname}",
			"tooltip-format": " {ifname} via {gwaddr}",
			"format-linked": " {ifname} (No IP)",
			"format-disconnected": "Disconnected ⚠ {ifname}",
			"format-alt": " {ifname}: {ipaddr}/{cidr}"
		},
		"cpu": {
			"format": "CPU: {usage}%",
			"interval": 2
		},
		"memory": {
			"interval": 30,
			"format": "RAM: {used:0.1f}G/{total:0.1f}G"
		},
		"pulseaudio": {
			"scroll-step": 5,
			"max-volume": 150,
			"format": "{volume}%",
			"on-click": "pavucontrol"
		},
		"clock": {
			"format": "{:%R %a %d-%m-%Y}",
			"tooltip": false
		}
	},
	{
		"output": "HDMI-A-3",
		"layer": "bottom",
		"position": "top",
		"height": 40,

		"modules-left": ["hyprland/workspaces"],
		"hyprland/workspaces": {
			"format": "{name}",
			"disable-scroll": true
		}
	}
]
